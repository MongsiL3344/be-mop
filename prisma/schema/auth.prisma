model User {
  id           String    @id @default(uuid())
  email        String
  passwordHash String
  nickname     String
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  @@unique([email], where: { deletedAt: null })
  @@unique([nickname], where: { deletedAt: null })
}
